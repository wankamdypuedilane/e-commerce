    {
      "id": 5,
      "type": "timeseries",
      "title": "Latence — p50 et p95",
      "description": "Quantiles estimés à partir de l'histogramme (bornes de 10 ms à 10 s). Un p95 plafonné à 10 s signifie « au-delà de 10 s ».",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(django_http_requests_latency_seconds_bucket{job=\"django\", view!~\"metrics|healthz\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(django_http_requests_latency_seconds_bucket{job=\"django\", view!~\"metrics|healthz\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, pod) (rate(django_http_requests_latency_seconds_bucket{job=\"django\", view!~\"metrics|healthz\"}[$__rate_interval])))",
          "legendFormat": "p95 {{pod}}",
          "refId": "C",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
