    {
      "id": 8,
      "type": "timeseries",
      "title": "Saturation — requêtes en cours",
      "description": "Requêtes en cours de traitement par pod, sur 3 workers gunicorn synchrones : 3 signifie que le pod est saturé. La collecte se compte elle-même (elle est en cours au moment de la mesure) ; elle est retranchée ici.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "clamp_min(sum by (pod) (django_http_requests_in_progress{job=\"django\"}) - 1, 0)",
          "legendFormat": "{{pod}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
