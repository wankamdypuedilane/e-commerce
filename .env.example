# Copiez ce fichier vers .env et remplissez les valeurs
# cp .env.example .env

# Django (securite)
# OBLIGATOIRE : l'application refuse de demarrer sans cette variable.
# Generer avec : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
# Vaut False par defaut. Ne jamais mettre True ailleurs qu'en developpement local.
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Login SMTP Brevo (souvent l'email de connexion Brevo)
BREVO_SMTP_LOGIN=votre_login_brevo

# Cle SMTP Brevo (SMTP Key)
BREVO_SMTP_KEY=votre_cle_smtp_brevo

# Email expediteur verifie dans Brevo
EMAIL_FROM=votre_email@gmail.com

# Stripe (paiement)
STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxx

# Base de donnees
# postgres : valeur normale, en conteneur comme en production
# sqlite   : uniquement pour un usage local hors Docker
DB_ENGINE=postgres
DB_NAME=ecommerce
DB_USER=postgres
DB_PASSWORD=votre_mot_de_passe
# Nom du service Docker, pas une adresse IP
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_SSLMODE=disable

# Facturation
TAX_RATE_PERCENT=20

# Origines de confiance CSRF, schema inclus, separees par des virgules.
# Obligatoire des que le site est servi en HTTPS derriere un proxy.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Niveau de journalisation : DEBUG, INFO, WARNING, ERROR
DJANGO_LOG_LEVEL=INFO

# Securite HTTPS : passer a True une fois le certificat en place.
# Derriere un Ingress, SECURE_PROXY_SSL_HEADER est deja configure.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

# HSTS : oblige le navigateur a n'utiliser que HTTPS pour ce domaine.
# 31536000 = 1 an. Laisser a 0 tant que le certificat n'est pas
# definitivement valide : une valeur elevee est difficile a annuler.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
